// Included by client_test.cpp: exercise the real Client through the same transport.
static void testCfo(Client& client, RecordingTransport& transport) {
    client.boss_.kind = BossKind::Cashbot;
    client.boss_.classId = dc::DistributedCashbotBoss::kClassId;
    std::strcpy(client.boss_.phase, "BattleThree");
    CfoChild& crane = client.cfoChildren_[0];
    crane.active = true;
    crane.doId = 300;
    crane.bossId = 100;
    crane.kind = CfoKind::Crane;
    crane.classId = dc::DistributedCashbotBossCrane::kClassId;
    crane.state = 'F';
    assert(client.sendCfoControl(300, true));
    assert(transport.update(300, dc::DistributedCashbotBossCrane::k_requestControl).remaining() == 0);
    crane.state = 'C';
    crane.owner = 43;
    assert(!client.sendCfoControl(300, false));
    float links[3][3] = {{0,20,-6}, {0,20,-13}, {0,20,-20}};
    assert(!client.sendCfoCable(300, 0, 20, 0, links));
    crane.owner = 42;
    assert(client.sendCfoClear(300));
    assert(transport.update(300, dc::DistributedCashbotBossCrane::k_clearSmoothing).i8() == 0);
    assert(client.sendCfoCable(300, 255, 24.5f, -45, links));
    DatagramReader cable = transport.update(300, dc::DistributedCashbotBossCrane::k_setCablePos);
    assert(cable.u8() == 255 && cable.i16() == 2450 && cable.u16() == 31500 && cable.remaining() == 20);
    assert(!client.sendCfoCable(300, 0, 26, 0, links));
    links[2][0] = NAN;
    assert(!client.sendCfoCable(300, 0, 20, 0, links));
    links[2][0] = 0;
    CfoChild& safe = client.cfoChildren_[1];
    safe.active = true;
    safe.doId = 301;
    safe.bossId = 100;
    safe.kind = CfoKind::Safe;
    safe.state = 'I';
    assert(client.sendCfoObject(301, Client::CfoAction::Grab));
    safe.state = 'G';
    safe.owner = 43;
    safe.crane = 300;
    assert(!client.sendCfoObject(301, Client::CfoAction::Drop));
    safe.owner = 42;
    assert(client.sendCfoObject(301, Client::CfoAction::Drop));
    assert(!client.sendCfoObject(301, Client::CfoAction::Hit, 1));
    safe.state = 'D';
    assert(!client.sendCfoObject(301, Client::CfoAction::Hit, NAN));
    assert(!client.sendCfoObject(301, Client::CfoAction::Hit, 1.01f));
    assert(client.sendCfoObject(301, Client::CfoAction::Hit, .5f));
    assert(transport.update(301, dc::DistributedCashbotBossObject::k_hitBoss).u16() == 128);
    assert(client.sendCfoPose(301, 120, -315, 8, 90));
    assert(transport.update(301, dc::DistributedCashbotBossObject::k_setSmXYZH).remaining() == 10);
    safe.crane = 100;
    assert(!client.sendCfoObject(301, Client::CfoAction::Hit, 1));
    assert(client.sendBossZap(120, -310, 0, 0, 0, 1, kBossSlowDirectedAttack));
    assert(!client.sendCfoReward());
    std::strcpy(client.boss_.phase, "Epilogue");
    assert(client.sendCfoReward());
    assert(!client.sendCfoReward());
    client.bossLeaving(301);
    assert(!client.findCfoChild(301));
    Battle battle{};
    battle.bossId = 100;
    client.positionBossBattle(battle);
    assert(battle.x == 145 && battle.y == -230 && battle.sx == 144);
    FILE* vectors = std::fopen("sdmc-out/boss-test/cfo_enters.bin", "rb");
    assert(vectors);
    uint32_t objectId = 0;
    int count = 0;
    while (std::fread(&objectId, 4, 1, vectors) == 1) {
        uint16_t classId = 0;
        uint32_t size = 0;
        uint8_t payload[512];
        assert(std::fread(&classId, 2, 1, vectors) == 1);
        assert(std::fread(&size, 4, 1, vectors) == 1 && size <= sizeof(payload));
        assert(std::fread(payload, 1, size, vectors) == size);
        const dc::ClassDesc* cls = findClass(classId);
        assert(cls);
        DatagramReader enter(payload, size);
        assert(client.handleBossEnter(objectId, classId, enter, requiredOther(*cls), cls->otherCount, true));
        assert(enter.ok() && !enter.remaining());
        assert(client.findCfoChild(objectId));
        const CfoChild before = *client.findCfoChild(objectId);
        DatagramReader bad(payload, size - 1);
        assert(client.handleBossEnter(objectId, classId, bad, requiredOther(*cls), cls->otherCount, true));
        assert(std::memcmp(client.findCfoChild(objectId), &before, sizeof(before)) == 0);
        client.bossLeaving(objectId);
        assert(!client.findCfoChild(objectId));
        ++count;
    }
    std::fclose(vectors);
    assert(count == 4);
    client.boss_.kind = BossKind::Sellbot;
    std::puts("CFO Client ownership, cable payload, impact, helmet, reward and child lifecycle: PASS");
}

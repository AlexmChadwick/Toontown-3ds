static void testCj(Client& client, RecordingTransport& transport) {
    client.boss_.kind = BossKind::Lawbot;
    client.boss_.classId = dc::DistributedLawbotBoss::kClassId;
    std::strcpy(client.boss_.phase, "BattleTwo");
    CjChild& cannon = client.cjChildren_[0];
    cannon.active = true;
    cannon.doId = 600;
    cannon.bossId = 100;
    cannon.classId = dc::DistributedLawbotCannon::kClassId;
    cannon.kind = CjKind::Cannon;
    cannon.index = 3;
    assert(client.sendCjCannon(600, Client::CjCannonAction::Enter));
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Fire));
    cannon.owner = 43;
    cannon.movie = 1;
    cannon.balls = 12;
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Leave));
    cannon.owner = 42;
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Aim, NAN, 30));
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Aim, 51, 30));
    assert(client.sendCjCannon(600, Client::CjCannonAction::Fire, -25, 35));
    DatagramReader fire = transport.update(600, dc::DistributedLawbotCannon::k_setCannonLit);
    assert(fire.i16() == -250 && fire.i16() == 350 && !fire.remaining());
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Fire));
    uint8_t bytes[64];
    DatagramWriter writer(bytes, sizeof(bytes));
    writer.u32(42);
    writer.i16(0);
    writer.i16(-250);
    writer.i16(350);
    writer.i16(-32760);
    DatagramReader update(bytes, writer.size());
    assert(client.handleCjField(update, 600, dc::DistributedLawbotCannon::k_setCannonWillFire));
    assert(cannon.inFlight && cannon.fireRevision == 1 && !cannon.pendingFire);
    CjChild& chair = client.cjChildren_[1];
    chair.active = true;
    chair.doId = 601;
    chair.bossId = 100;
    chair.kind = CjKind::Chair;
    chair.index = 11;
    assert(!client.sendCjChair(600, 12));
    assert(client.sendCjChair(600, 11));
    DatagramReader hit = transport.update(100, dc::DistributedLawbotBoss::k_hitChair);
    assert(hit.u8() == 11 && hit.u8() == 3 && !hit.remaining());
    assert(!client.sendCjChair(600, 11));
    assert(client.sendCjCannon(600, Client::CjCannonAction::Landed));
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Landed));
    std::strcpy(client.boss_.phase, "BattleThree");
    assert(!client.sendCjCannon(600, Client::CjCannonAction::Fire));
    assert(client.sendCjEvidence(Client::CjEvidence::Witness));
    assert(client.sendCjEvidence(Client::CjEvidence::Defense));
    assert(transport.update(100, dc::DistributedLawbotBoss::k_hitBoss).u8() == 1);
    assert(!client.sendCjEvidence(Client::CjEvidence::Toon, 42));
    assert(!client.sendCjEvidence(Client::CjEvidence::Lawyer, 999));
    assert(client.sendCjZap(0, 0, 0, 90, 13));
    assert(!client.sendCjZap(0, 0, 0, 90, 20));
    client.bossLeaving(600);
    assert(!client.findCjChild(600));
    client.boss_.kind = BossKind::Sellbot;
    std::puts("CJ real Client: control/phase guards, cannon wire/flight, chair ownership, evidence and zap: PASS");
}

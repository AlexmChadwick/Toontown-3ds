; Vertex-animation (morph) shader for toon parts. Blends two baked frames of a
; .tta animation (tools/pipeline/tta.py); uv/color come from the part's .ttm.
;   v0 = s16 bind position (unused; present because the .ttm buffer interleaves it)
;   v1 = s16 uv (x/1024)
;   v2 = u8 rgba
;   v3 = s16 position, frame A (dequantization folded into modelView)
;   v4 = s16 position, frame B
.fvec projection[4], modelView[4]
.fvec tint
.fvec blend ; x = weight of frame B

; x = 1/255 (color), y = 1/1024 (uv), z = 1, w = 0
.constf consts(0.003921569, 0.0009765625, 1.0, 0.0)
.alias  ones consts.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias intex v1
.alias inclr v2
.alias inposA v3
.alias inposB v4

.proc main
    ; r0 = A + (B - A) * blend.x  (one input register per instruction on PICA)
    mov r2, inposB
    add r1, -inposA, r2
    mul r1, blend.xxxx, r1
    add r0, inposA, r1
    mov r0.w, ones

    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0

    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    mul outtc0, consts.yyyy, intex

    mul r2, consts.xxxx, inclr
    mul outclr, tint, r2
    end
.end
